{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/:jahr(20[0-9]{2})/:path*",
      "destination": "/:jahr/index.html"
    }
  ],
  "headers": [
    {
      "source": "/:jahr(20[0-9]{2})/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
